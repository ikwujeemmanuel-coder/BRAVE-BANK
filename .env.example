APP_NAME=BRAVEBANK
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL connection string (Neon PostgreSQL in production)
DATABASE_URL=postgresql+psycopg://bravebank:bravebank@localhost:5432/bravebank
DIRECT_URL=postgresql+psycopg://bravebank:bravebank@localhost:5432/bravebank
TEST_DATABASE_URL=postgresql+psycopg://bravebank:bravebank@localhost:5432/bravebank_test

# Email & SMS verification settings (mock in dev/test; SMTP in production; never expose dev OTPs in prod)
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bravebank.ng
SMTP_USE_TLS=true

SMS_PROVIDER=mock
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# CORS & Server
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://bravebank-frontend.onrender.com
FRONTEND_URL=https://bravebank-frontend.onrender.com
PORT=3000
